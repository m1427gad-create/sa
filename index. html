<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>العرض التقديمي المتكامل - اليوم الوطني السعودي 96</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;500;700;900&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <style>
        :root {
            --sa-green: #006c35;
            --sa-bright-green: #00e676;
            --sa-gold: #d4af37;
            --bg-dark: #020804;
            --glass: rgba(0, 50, 25, 0.85);
            --glass-border: rgba(0, 230, 118, 0.5);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Tajawal', sans-serif; }
        body { background-color: var(--bg-dark); color: #fff; height: 100vh; height: 100dvh; overflow: hidden; display: flex; position: relative; }

        #webgl-container { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }

        .content-container {
            position: absolute; right: 5%; top: 0; width: 45%; height: 100%;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            z-index: 10; pointer-events: none; padding: 20px 0;
        }

        #slides-holder { width: 100%; max-width: 580px; pointer-events: auto; }

        .slide { display: none; width: 100%; flex-direction: column; align-items: center; text-align: center; }
        .slide.active { display: flex; animation: fadeIn 0.4s ease; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card {
            background: var(--glass); border: 2px solid var(--glass-border);
            padding: 25px; border-radius: 20px; width: 100%;
            backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.8); text-align: right;
        }

        .slide-num { color: var(--sa-bright-green); font-size: 0.9rem; font-weight: bold; margin-bottom: 8px; display: block; border-bottom: 1px solid var(--glass-border); padding-bottom: 5px; }
        .slide-icon { font-size: 3rem; text-align: center; margin-bottom: 10px; display: block; }
        h1 { color: var(--sa-bright-green); font-size: 1.7rem; margin-bottom: 12px; font-weight: 900; line-height: 1.3; }
        p { font-size: 1.05rem; color: #e0e0e0; line-height: 1.6; margin-bottom: 15px; }

        .controls { display: flex; justify-content: space-between; width: 100%; max-width: 580px; margin-top: 15px; pointer-events: auto; }
        .btn {
            background: linear-gradient(135deg, var(--sa-green), #004d24); border: 1.5px solid var(--sa-bright-green);
            color: #fff; padding: 10px 22px; border-radius: 8px; cursor: pointer;
            font-weight: bold; font-size: 1rem; transition: 0.3s;
        }
        .btn:hover { background: var(--sa-bright-green); color: var(--bg-dark); }
        .btn:disabled { opacity: 0.3; cursor: not-allowed; }

        .option {
            padding: 12px 14px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
            border-radius: 8px; margin-bottom: 10px; cursor: pointer; transition: 0.3s; text-align: right; font-size: 1rem;
        }
        .option:hover { background: rgba(0,230,118,0.25); border-color: var(--sa-bright-green); }
        .option.correct { background: #1b5e20 !important; border-color: #4caf50 !important; }
        .option.wrong { background: #b71c1c !important; border-color: #ef5350 !important; }

        .progress-container { position: fixed; top: 0; width: 100%; height: 6px; background: rgba(255,255,255,0.1); z-index: 1000; }
        #progress-bar { height: 100%; width: 5%; background: linear-gradient(90deg, var(--sa-green), var(--sa-bright-green)); transition: 0.3s; }

        .signature { position: fixed; bottom: 12px; right: 12px; padding: 6px 12px; background: var(--glass); border: 1px solid var(--sa-bright-green); border-radius: 8px; color: var(--sa-bright-green); font-weight: bold; font-size: 0.8rem; z-index: 100; pointer-events: auto; }

        @media (max-width: 900px) {
            .content-container { right: 0; left: 0; top: auto; bottom: 50px; width: 100%; max-height: 70vh; padding: 10px 15px; }
            .card { padding: 15px; }
            h1 { font-size: 1.3rem; }
            p { font-size: 0.9rem; line-height: 1.4; }
            .slide-icon { font-size: 2.2rem; margin-bottom: 5px; }
            .signature { right: 50%; transform: translateX(50%); bottom: 5px; font-size: 0.75rem; white-space: nowrap; }
        }
    </style>
</head>
<body>

<div id="webgl-container"></div>
<div class="progress-container"><div id="progress-bar"></div></div>

<div class="content-container">
    <div id="slides-holder"></div>
    
    <div class="controls">
        <button class="btn" id="prevBtn" onclick="changeSlide(-1)">السابق</button>
        <button class="btn" id="nextBtn" onclick="changeSlide(1)">التالي</button>
    </div>
</div>

<div class="signature">✨ ابتدائية عمير بن الحمام الأنصاري // أ. ماجد العوفي ✨</div>

<script>
    const presentationData = [
        { type: "info", icon: "🇸🇦", title: "المملكة العربية السعودية واليوم الوطني 96", desc: "عرض تقديمي تفاعلي شامل للطلاب للتعرف على تاريخ وطننا المعطاء، أماكنه المقدسة، معالمه التاريخية، ومشاريع مستقبله الواعد." },
        { type: "info", icon: "🌴", title: "مقدمة عن اليوم الوطني 96", desc: "يحتفل الشعب السعودي باليوم الوطني تخليداً لذكرى توحيد المملكة على يد المغفور له الملك عبد العزيز آل سعود في عام 1351هـ / 1932م." },
        { type: "info", icon: "⚔️", title: "يوم التأسيس vs اليوم الوطني", desc: "يوم التأسيس (22 فبراير 1727م) يرمز لبداية قيام الدولة السعودية الأولى، بينما اليوم الوطني (23 سبتمبر 1932م) يرمز لتوحيد كافة مناطق المملكة باسمها الحالي." },
        { type: "info", icon: "🛡️", title: "شعار وحلم المملكة", desc: "يتكون الشعار الرسمي من سيفين عربيين متقاطعين تعلوهما نخلة؛ حيث يرمز السيفان إلى القوة والعدل والمنعة، بينما ترمز النخلة إلى النماء والرخاء." },
        { type: "info", icon: "🕋", title: "الأماكن المقدسة: مكة المكرمة", desc: "قبلة المسلمين ومأوى الأفئدة، تضم المسجد الحرام والكعبة المشرفة، وتستقبل ملايين الحجاج والمعتمرين سنوياً وسط خدمات وتقنيات متطورة." },
        { type: "info", icon: "🕌", title: "الأماكن المقدسة: المدينة المنورة", desc: "دار الهجرة النبوية وعاصمة الإسلام الأولى، تضم المسجد النبوي الشريف والروضة الشريفة والجبال التاريخية كجبل أحد." },
        { type: "info", icon: "⛺", title: "المشاعر المقدسة", desc: "تضم منى ومزدلفة وعرفات، وهي الأماكن المخصصة لأداء مناسك الحج، وتتميز بأكبر مدينة خيام مطورة ومشاريع تفويج عالمية المستوى." },
        { type: "info", icon: "🏰", title: "الأماكن التاريخية: قصر المصمك", desc: "حصن مبني من اللبن يقع في قلب الرياض، شهد ملحمة فتح الرياض عام 1902م على يد الملك عبد العزيز، ويعتبر نقطة الانطلاق لتأسيس المملكة." },
        { type: "info", icon: "🏛️", title: "الأماكن التاريخية: الدرعية التاريخية", desc: "عاصمة الدولة السعودية الأولى، وتضم حي الطريف المسجل في قائمة اليونسكو للتراث العالمي، وتجسد رمز الأصالة والجذور التاريخية." },
        { type: "info", icon: "🏜️", title: "الأماكن التاريخية: العلا ومدائن صالح", desc: "متحف مفتوح للحضارات القديمة كالمملكة النبطية، وتضم معالم أثرية عالمية مثل 'الحجر' ومقابر القصر الفريد ومهرجان شتاء طنطورة." },
        { type: "info", icon: "🌐", title: "الأماكن الحديثة: مشروع نيوم (NEOM)", desc: "مدينة المستقبل الذكية والمستدامة بشمال غرب المملكة، وتضم مشاريع عملاقة مثل ذا لاين (The Line)، سندالة، وأوكساجون اعتماداً على الطاقة النظيفة." },
        { type: "info", icon: "🌊", title: "الأماكن الحديثة: مشروع البحر الأحمر", desc: "وجهة سياحية فاخرة تعتمد على الطبيعة والطاقة المتجددة 100%، وتضم جزر بكر وحيوانات بصرية وحيود مرجانية فريدة." },
        { type: "info", icon: "🎡", title: "الأماكن الحديثة: القدية (عاصمة الترفيه)", desc: "مركز الترفيه والرياضة والفنون القادم بالقرب من الرياض، يهدف لجعل العاصمة واحدة من أمتع مدن العالم عبر مدن الملاهي والمنتزهات." },
        { type: "info", icon: "🚀", title: "رؤية السعودية 2030", desc: "خطة طموحة أطلقها صاحب السمو الملكي الأمير محمد بن سلمان لتنويع الاقتصاد، تعزيز جودة الحياة، وبناء مستقبل مستدام للأجيال القادمة." },
        { type: "info", icon: "⛰️", title: "الطبيعة والتنوع الجغرافي", desc: "تتميز المملكة بتنوع بيئي ساحر يمتد من شواطئ البحر الأحمر المرجانية إلى جبال السودة الخضراء وعروق الربع الخالي الذهبية." },
        { type: "quiz", icon: "❓", title: "سؤال تفاعلي (1)", q: "ما هو تاريخ إعلان توحيد المملكة العربية السعودية رسمياً؟", a: ["22 فبراير 1727م", "23 سبتمبر 1932م", "15 يناير 1902م"], c: 1 },
        { type: "quiz", icon: "❓", title: "سؤال تفاعلي (2)", q: "أي من المعالم التالية يعتبر العاصمة الأولى للدولة السعودية الأولى؟", a: ["قصر المصمك", "الدرعية التاريخية", "مدائن صالح"], c: 1 },
        { type: "quiz", icon: "❓", title: "سؤال تفاعلي (3)", q: "ما هو اسم مشروع المدينة المستقبلية المستدامة القائمة على الطاقة النظيفة؟", a: ["مشروع القدية", "مشروع نيوم", "مشروع أمالا"], c: 1 },
        { type: "quiz", icon: "❓", title: "سؤال تفاعلي (4)", q: "إلامَ ترمز النخلة في الشعار الرسمي للمملكة؟", a: ["القوة والعدل", "النماء والرخاء", "التراث القريب"], c: 1 },
        { type: "info", icon: "🏆", title: "ختام العرض التقديمي", desc: "دام عزك يا وطن! نشكر الطلاب والطالبات على المتابعة والاهتمام بتاريخ ونهضة وطننا الغالي." }
    ];

    let currentSlide = 0;

    function renderSlides() {
        const holder = document.getElementById('slides-holder');
        holder.innerHTML = '';

        presentationData.forEach((slide, idx) => {
            const slideDiv = document.createElement('div');
            slideDiv.className = `slide ${idx === 0 ? 'active' : ''}`;
            slideDiv.id = `slide-${idx}`;

            let contentHTML = `<div class="card">
                <span class="slide-num">الشريحة ${idx + 1} من ${presentationData.length}</span>
                <span class="slide-icon">${slide.icon}</span>
                <h1>${slide.title}</h1>`;

            if (slide.type === 'quiz') {
                contentHTML += `<p style="font-weight:bold; color:#fff;">${slide.q}</p><div id="opts-${idx}">`;
                slide.a.forEach((opt, oIdx) => {
                    contentHTML += `<div class="option" onclick="checkQuiz(${idx}, ${oIdx}, ${slide.c}, this)">${opt}</div>`;
                });
                contentHTML += `</div>`;
            } else {
                contentHTML += `<p>${slide.desc}</p>`;
            }

            contentHTML += `</div>`;
            slideDiv.innerHTML = contentHTML;
            holder.appendChild(slideDiv);
        });
        updateButtons();
    }

    function checkQuiz(slideIdx, selected, correct, el) {
        const parent = document.getElementById(`opts-${slideIdx}`);
        const opts = parent.querySelectorAll('.option');
        opts.forEach(o => o.style.pointerEvents = 'none');

        if (selected === correct) {
            el.classList.add('correct');
        } else {
            el.classList.add('wrong');
            opts[correct].classList.add('correct');
        }
    }

    function changeSlide(direction) {
        const total = presentationData.length;
        document.getElementById(`slide-${currentSlide}`).classList.remove('active');
        currentSlide += direction;

        if (currentSlide < 0) currentSlide = 0;
        if (currentSlide >= total) currentSlide = total - 1;

        document.getElementById(`slide-${currentSlide}`).classList.add('active');
        document.getElementById('progress-bar').style.width = `${((currentSlide + 1) / total) * 100}%`;
        updateButtons();
    }

    function updateButtons() {
        document.getElementById('prevBtn').disabled = currentSlide === 0;
        document.getElementById('nextBtn').disabled = currentSlide === presentationData.length - 1;
    }

    const container = document.getElementById('webgl-container');
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;

    const mapGroup = new THREE.Group();
    const saudiOutline = [
        [28.5, 34.8], [29.5, 35.0], [29.3, 36.5], [31.5, 37.0], [32.1, 39.0], 
        [31.0, 40.5], [30.0, 42.5], [29.1, 46.5], [28.3, 48.5], [27.0, 49.6], 
        [25.5, 50.8], [24.5, 51.5], [23.0, 53.0], [22.5, 55.0], [20.0, 55.5], 
        [19.0, 52.0], [17.5, 50.0], [16.5, 43.1], [17.5, 42.0], [19.5, 41.5], 
        [21.5, 39.1], [24.0, 37.5], [26.0, 36.5], [28.5, 34.8]
    ];

    function isInsideSaudi(lat, lng) {
        let inside = false;
        for (let i = 0, j = saudiOutline.length - 1; i < saudiOutline.length; j = i++) {
            let xi = saudiOutline[i][0], yi = saudiOutline[i][1];
            let xj = saudiOutline[j][0], yj = saudiOutline[j][1];
            let intersect = ((yi > lng) !== (yj > lng)) && (lat < (xj - xi) * (lng - yi) / (yj - yi) + xi);
            if (intersect) inside = !inside;
        }
        return inside;
    }

    function createSaudiMap3D() {
        const positions = [];
        const colors = [];
        const brightGreen = new THREE.Color('#00e676');
        const deepGreen = new THREE.Color('#006c35');

        for (let i = 0; i < 5500; i++) {
            let lat = 16.0 + Math.random() * 16.5;
            let lng = 34.5 + Math.random() * 21.5;
            if (isInsideSaudi(lat, lng)) {
                positions.push((lng - 45) * 0.22, (lat - 24) * 0.22, (Math.random() - 0.5) * 0.3);
                let c = Math.random() > 0.3 ? brightGreen : deepGreen;
                colors.push(c.r, c.g, c.b);
            }
        }

        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
        geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
        const material = new THREE.PointsMaterial({ size: 0.05, vertexColors: true, transparent: true, opacity: 0.9 });
        mapGroup.add(new THREE.Points(geometry, material));
        scene.add(mapGroup);
        adjustLayout();
    }

    function adjustLayout() {
        if (window.innerWidth <= 900) {
            camera.position.set(0, 0, 11);
            mapGroup.position.set(0, 1.8, 0);
            mapGroup.scale.set(0.85, 0.85, 0.85);
        } else {
            camera.position.set(-2, 0, 10);
            mapGroup.position.set(-2.5, 0, 0);
            mapGroup.scale.set(1, 1, 1);
        }
    }

    let rot = 0;
    function animate() {
        requestAnimationFrame(animate);
        rot += 0.006;
        mapGroup.rotation.y = Math.sin(rot) * 0.2;
        controls.update();
        renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
        adjustLayout();
    });

    renderSlides();
    createSaudiMap3D();
    animate();
</script>
</body>
</html>
